{
    "bot": {
        "prefix": "!",
        "delay_seconds": 0.1,
        "token_env": "WZ_BOT_TOKEN"
    },
    "database": {
        "folder": "data",
        "filename": "data.db"
    },
    "monitoring": {
        "interval_seconds": 60,
        "cpu_threshold": 90.0,
        "memory_threshold": 80.0,
        "disk_threshold": 90.0,
        "temperature_threshold": 80.0
    },
    "wz_registration": {
        "max_registration_roles": 4,
        "min_registration_roles": 1,
        "default_title": "Anmeldung",
        "default_description": "Klicke zum An-/Abmelden eine der Schaltfl\u00e4chen unten!"
    }
}